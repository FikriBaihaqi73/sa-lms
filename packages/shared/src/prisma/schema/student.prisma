model Student {
  // base
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // attributes
  profileId        String?  @unique @map("profile_id") @db.Uuid
  departmentId     String? @map("department_id") @db.Uuid
  academicStatusId String  @map("academic_status_id") @db.Uuid
  studentNumber    String    @unique @map("student_number")
  enrollmentYear   Int?      @map("enrollment_year")
  referralCode     String?   @map("referral_code") @db.VarChar(100)
  referralExpiresAt DateTime? @map("referral_expires_at") @db.Timestamp

  // relations
  profile               Profile?                @relation(fields: [profileId], references: [id])
  studentGuardians      StudentGuardian[]
  examinationScores     ExaminationScores[]
  classStudents         ClassStudent[]
  attendances           Attendances[]
  studyPlans            StudyPlans[]
  assignmentSubmissions AssignmentSubmission[]
  studentGrades         StudentGrades[]
  studyResults          StudyResult[]

  @@map("students")
}
