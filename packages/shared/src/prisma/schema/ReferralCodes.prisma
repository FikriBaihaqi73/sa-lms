model ReferralCodes {
  // base
  id         String    @id @default(uuid()) @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamp
  updated_at DateTime  @updatedAt @db.Timestamp
  deleted_at DateTime? @db.Timestamp

  // attributes
  code            String    @unique @db.VarChar(100)
  institution_id  String    @db.Uuid
  usage_quota     Int?      @map("usage_quota")
  used_count      Int       @default(0) @map("used_count")
  enrollment_year Int?      @map("enrollment_year")
  department_id   String?   @map("department_id") @db.Uuid
  expires_at      DateTime? @map("expires_at") @db.Timestamp
  is_active       Boolean   @default(true) @map("is_active")

  // relations
  institution Institution  @relation(fields: [institution_id], references: [id])
  department  Departments? @relation(fields: [department_id], references: [id])

  @@index([institution_id])
  @@index([code])
  @@map("referral_codes")
}
