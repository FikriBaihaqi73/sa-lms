{
    "name": "@repo/shared",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "prisma:generate": "prisma generate --schema src/prisma",
        "prisma:migrate": "prisma migrate dev --schema src/prisma",
        "prisma:push": "prisma db push --schema src/prisma",
        "prisma:reset": "prisma migrate reset --schema src/prisma",
        "build": "swc src -d dist --strip-leading-paths",
        "format": "biome check --write",
        "lint": "biome check",
        "seed:roles": "tsx src/script/seed-roles.ts",
        "seed:users": "tsx src/script/seed-users.ts"
    },
    "exports": {
        "./*": {
            "types": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "imports": {
        "#*": {
            "types": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "dependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/swagger": "^11.2.3",
        "@prisma/adapter-pg": "7.0.0",
        "@prisma/client": "7.0.0",
        "@scalar/nestjs-api-reference": "^1.2.17",
        "@types/bcrypt": "^6.0.0",
        "bcrypt": "^6.0.0",
        "dotenv": "^16.4.5",
        "nestjs-zod": "^5.0.1",
        "pg": "^8.11.3",
        "prisma": "7.0.0",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@repo/biome-config": "workspace:*",
        "@swc/cli": "^0.8.0",
        "@swc/core": "^1.10.0",
        "@types/jest": "^29.5.14",
        "@types/pg": "^8.11.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vitest": "^5.0.3"
    }
}
